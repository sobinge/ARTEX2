# Docker 部署配置（复制为 .env）
# 默认用本地源码构建的镜像（artex-local），不再拉线上镜像。
# 如需官方发布镜像，可改为 ARTEX_IMAGE=ruoji6/artex。
ARTEX_IMAGE=artex-local
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
